<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>F1SimHubLive-Installer</AssemblyName>
    <RootNamespace>F1SimHubLive.Installer</RootNamespace>
    <Version>1.7.0</Version>
    <AssemblyVersion>1.7.0.0</AssemblyVersion>
    <FileVersion>1.7.0.0</FileVersion>
    <InformationalVersion>1.7.0</InformationalVersion>
    <AssemblyTitle>F1SimHubLive Installer</AssemblyTitle>
    <Product>F1SimHubLive</Product>
    <Company>vicslive</Company>
    <Copyright>Copyright Ã‚Â© 2026 Victor de Souza</Copyright>
    <Description>Installs the F1SimHubLive SimHub plugin and F1RaceSim_GSIFPEV2 dashboard</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\F1SimHubLive.dll" />
    <EmbeddedResource Include="Assets\Microsoft.AspNet.SignalR.Client.dll" />
    <EmbeddedResource Include="Assets\F1RaceSim_GSIFPEV2.djson" />
    <EmbeddedResource Include="Assets\F1RaceSim_GSIFPEV2.djson.ressources" />
    <EmbeddedResource Include="Assets\F1RaceSim_GSIFPEV2.djson.metadata" />
    <EmbeddedResource Include="Assets\F1RaceSim_GSIFPEV2.djson.png" />
    <EmbeddedResource Include="Assets\F1RaceSim_GSIFPEV2.djson.00.png" />
    <EmbeddedResource Include="Assets\drivers-fallback.json" />
    <EmbeddedResource Include="Assets\LedProfiles\leds-F1SimHubLive-Telemetry.json" />
    <EmbeddedResource Include="Assets\LedProfiles\buttons-F1SimHubLive.json" />
    <EmbeddedResource Include="Assets\LedProfiles\raw-F1SimHubLive-PrimeGradient.json" />
  </ItemGroup>

  <!--
    Embed the published Driver Picker exe so the installer can drop it next
    to the plugin DLL. The picker is built+published by the PublishPicker
    target below; the EmbeddedResource entry references the published path
    and is wrapped in <Exists> so the project still loads in IDEs before the
    first build.
  -->
  <ItemGroup>
    <EmbeddedResource
        Include="..\picker\bin\$(Configuration)\net8.0-windows\win-x64\publish\F1SimHubLive-Picker.exe"
        Condition="Exists('..\picker\bin\$(Configuration)\net8.0-windows\win-x64\publish\F1SimHubLive-Picker.exe')">
      <LogicalName>F1SimHubLive-Picker.exe</LogicalName>
      <Visible>false</Visible>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="PublishPicker"
          BeforeTargets="ResolveReferences;PrepareResources;CoreCompile"
          Condition="!Exists('..\picker\bin\$(Configuration)\net8.0-windows\win-x64\publish\F1SimHubLive-Picker.exe')">
    <Message Importance="high"
             Text="Publishing F1SimHubLive.Picker ($(Configuration)) so the installer can embed it..." />
    <MSBuild Projects="..\picker\F1SimHubLive.Picker.csproj"
             Targets="Restore;Publish"
             Properties="Configuration=$(Configuration)" />
    <!--
      Dynamically add the embedded resource now that the picker has been
      published — the static ItemGroup above only kicks in on subsequent builds
      after the publish output is cached on disk.
    -->
    <ItemGroup>
      <EmbeddedResource
          Include="..\picker\bin\$(Configuration)\net8.0-windows\win-x64\publish\F1SimHubLive-Picker.exe">
        <LogicalName>F1SimHubLive-Picker.exe</LogicalName>
        <Visible>false</Visible>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

  <!--
    Always rebuild the F1SimHubLive plugin DLL from source before embedding it
    in the installer. Without this target the build picks up whatever stale
    binary happens to be committed at installer/Assets/F1SimHubLive.dll —
    which is what shipped (broken, no picker code) in every v1.1.x release
    before v1.1.2. We pass DeploySimHub=false so the plugin csproj's
    post-build deploy-to-SimHub step (scripts/deploy.ps1) doesn't fire and
    interact with a running SimHub during installer builds.

    Plugin csproj targets net48 with AppendTargetFrameworkToOutputPath=false,
    so the build output lands at ..\bin\$(Configuration)\F1SimHubLive.dll
    (no per-TFM subfolder). Always runs — adds ~3 sec to installer builds
    and is the explicit fix for the v1.1.x stale-DLL bug.
  -->
  <Target Name="PublishPlugin"
          BeforeTargets="ResolveReferences;PrepareResources;CoreCompile">
    <Message Importance="high"
             Text="Rebuilding F1SimHubLive plugin DLL ($(Configuration)) so the installer embeds the latest source..." />
    <MSBuild Projects="..\F1SimHubLive.csproj"
             Targets="Restore;Build"
             Properties="Configuration=$(Configuration);DeploySimHub=false" />
    <Copy SourceFiles="..\bin\$(Configuration)\F1SimHubLive.dll"
          DestinationFiles="Assets\F1SimHubLive.dll" />
  </Target>

</Project>
