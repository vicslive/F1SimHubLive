<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\picker.ico</ApplicationIcon>
    <AssemblyName>F1SimHubLive-Picker</AssemblyName>
    <RootNamespace>F1SimHubLive.Picker</RootNamespace>
    <Version>1.10.17</Version>
    <AssemblyVersion>1.10.17.0</AssemblyVersion>
    <FileVersion>1.10.17.0</FileVersion>
    <InformationalVersion>1.10.17</InformationalVersion>
    <AssemblyTitle>F1SimHubLive Driver Picker</AssemblyTitle>
    <Product>F1SimHubLive</Product>
    <Company>vicslive</Company>
    <Copyright>Copyright (c) 2026 Victor de Souza</Copyright>
    <Description>Live driver picker for the F1SimHubLive SimHub plugin</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\picker.ico" />
    <Resource Include="Assets\Flags\*.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- v1.5.4: parity with the plugin's CarData parser. The plugin uses
         Newtonsoft.Json on net48 and parses MV CarData responses
         successfully on every machine. The picker (net8) previously used
         System.Text.Json with default strict options and silently failed
         on at least one user environment (Vic's Media PC) despite the
         plugin succeeding on the same MV instance. Switching the picker
         to Newtonsoft eliminates the parser-strictness asymmetry as a
         failure mode. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
