<Window x:Class="F1SimHubLive.Picker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:F1SimHubLive.Picker.Services"
        xmlns:models="clr-namespace:F1SimHubLive.Picker.Models"
        Title="F1SimHubLive"
        Icon="Assets/picker.ico"
        Width="360" Height="960"
        MinWidth="300" MinHeight="540"
        Background="#0F0F12"
        Foreground="#E8E8EC"
        FontFamily="Segoe UI"
        Topmost="True"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <svc:HexToBrushConverter x:Key="HexToBrush" />

        <Style x:Key="DriverButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A1A20" />
            <Setter Property="BorderBrush" Value="#2A2A33" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#E8E8EC" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#23232C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E2E3A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="BorderBrush" Value="#3FD06A" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="Background" Value="#1B2A1F" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True" Margin="10">

        <!-- Header -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="F1SimHubLive" FontSize="13" FontWeight="Bold"
                           Foreground="#E83A3A" />
                <TextBlock x:Name="CurrentDriverText"
                           Text="—" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"
                           Foreground="#FFFFFF" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        VerticalAlignment="Center">
                <ToggleButton x:Name="LedToggle"
                              Content="💡 LEDs"
                              Foreground="#C8C8D0"
                              Background="Transparent"
                              BorderBrush="#2A2A33"
                              BorderThickness="1"
                              Padding="6,2"
                              Margin="0,0,8,0"
                              Cursor="Hand"
                              ToolTip="Show shift-light range sliders"
                              Checked="LedToggle_Changed"
                              Unchecked="LedToggle_Changed" />
                <CheckBox x:Name="TopmostCheck"
                          Content="📌 Pin" IsChecked="True"
                          Foreground="#C8C8D0"
                          VerticalAlignment="Center"
                          Checked="TopmostCheck_Changed"
                          Unchecked="TopmostCheck_Changed" />
            </StackPanel>
        </Grid>

        <!-- Status bar -->
        <Border DockPanel.Dock="Top" Background="#15151B"
                CornerRadius="4" Padding="8,5" Margin="0,0,0,8">
            <TextBlock x:Name="StatusText"
                       Text="Connecting to MultiViewer…"
                       FontSize="11" Foreground="#9090A0"
                       TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- Shift-light range sliders -->
        <Border x:Name="SliderStrip"
                DockPanel.Dock="Bottom" Background="#0A0A0E"
                CornerRadius="6" Padding="10,8" Margin="0,8,0,0"
                BorderBrush="#1F1F26" BorderThickness="1"
                Visibility="Collapsed">
            <StackPanel>
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Shift-light range" FontSize="10" FontWeight="SemiBold"
                               Foreground="#7F7F8A" />
                    <TextBlock Grid.Column="1" x:Name="RangeSummary"
                               Text=""
                               FontSize="10" Foreground="#9898A4" />
                </Grid>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Start" FontSize="11" Foreground="#C8C8D0"
                               VerticalAlignment="Center" />
                    <Slider Grid.Column="1" x:Name="StartRpmSlider"
                            Minimum="1000" Maximum="18000"
                            TickFrequency="500" IsSnapToTickEnabled="True"
                            SmallChange="100" LargeChange="500"
                            VerticalAlignment="Center"
                            Margin="6,0" />
                    <TextBlock Grid.Column="2" x:Name="StartRpmText"
                               Text="—"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="#E8E8EE"
                               VerticalAlignment="Center"
                               TextAlignment="Right" />
                </Grid>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="End" FontSize="11" Foreground="#C8C8D0"
                               VerticalAlignment="Center" />
                    <Slider Grid.Column="1" x:Name="EndRpmSlider"
                            Minimum="1000" Maximum="18000"
                            TickFrequency="500" IsSnapToTickEnabled="True"
                            SmallChange="100" LargeChange="500"
                            VerticalAlignment="Center"
                            Margin="6,0" />
                    <TextBlock Grid.Column="2" x:Name="EndRpmText"
                               Text="—"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="#E8E8EE"
                               VerticalAlignment="Center"
                               TextAlignment="Right" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="VersionText"
                       Grid.Column="0"
                       Text="v?.?.?"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="#C8C8D0"
                       VerticalAlignment="Center"
                       ToolTipService.ShowDuration="20000" />
            <TextBlock x:Name="UpdateText"
                       Grid.Column="1"
                       Visibility="Collapsed"
                       FontSize="14" FontWeight="SemiBold"
                       VerticalAlignment="Center">
                <Hyperlink x:Name="UpdateLink"
                           Foreground="#F5C04C"
                           TextDecorations="None"
                           RequestNavigate="UpdateLink_RequestNavigate"
                           NavigateUri="https://github.com/vicslive/F1SimHubLive/releases">
                    <Run x:Name="UpdateRun" Text="▲ update available" />
                </Hyperlink>
            </TextBlock>
        </Grid>

        <!-- Hidden — kept so existing code that writes to SettingsPathText
             (tooltip text) still compiles. The path now lives in
             VersionText.ToolTip. -->
        <TextBlock x:Name="SettingsPathText" Visibility="Collapsed" />

        <!-- Driver list with vertical LED strip on the left.
             Each driver row is 70 px tall (64 height + 6 bottom margin) so
             two LEDs per row gives a clean 14-LED bar spanning roughly seven
             drivers — which matches the picker's default visible roster. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Vertical LED strip + live RPM readout.
                 LEDs are fixed at 35 px tall so two LEDs line up exactly
                 with one driver row (rows are 64 + 6 margin = 70 px). That
                 means the full 14-LED bar spans the top 7 driver rows —
                 anchored to the top so position 1 sits next to LED 14
                 (the redline LED that lights last). -->
            <DockPanel Grid.Column="0" LastChildFill="True"
                       Width="26" Margin="0,0,8,0"
                       VerticalAlignment="Top">
                <Border DockPanel.Dock="Top"
                        Background="#0A0A0E"
                        CornerRadius="6" Padding="4,6"
                        BorderBrush="#1F1F26" BorderThickness="1">
                    <ItemsControl x:Name="LedStrip">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding}"
                                        Margin="0,1"
                                        CornerRadius="2"
                                        Height="35" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <TextBlock x:Name="RpmReadout"
                           Text="—"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="#9898A4"
                           TextAlignment="Center"
                           Margin="0,4,0,0"
                           ToolTip="Live RPM (MultiViewer telemetry)" />
            </DockPanel>

            <!-- Driver list -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="DriverList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:DriverEntry}">
                        <Button Style="{StaticResource DriverButtonStyle}"
                                Margin="0,0,0,6"
                                Click="DriverButton_Click"
                                Tag="{Binding Number}">
                            <Grid Height="64">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Team-colour TLA tile -->
                                <Border Grid.Column="0"
                                        Background="{Binding TeamColour, Converter={StaticResource HexToBrush}}"
                                        CornerRadius="3,0,0,3">
                                    <TextBlock Text="{Binding Tla}"
                                               Foreground="White"
                                               FontSize="24" FontWeight="Black"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <!-- Name block -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                            Margin="10,0,4,0">
                                    <TextBlock Text="{Binding DisplayLastName}"
                                               FontSize="16" FontWeight="Bold"
                                               Foreground="#FFFFFF"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding TeamName}"
                                               FontSize="10"
                                               Foreground="#9898A4"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,1,0,0" />
                                </StackPanel>
                                <!-- Big number + points stack -->
                                <StackPanel Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Number}"
                                               FontSize="28" FontWeight="Black"
                                               Foreground="#E8E8EE"
                                               HorizontalAlignment="Right"
                                               LineHeight="30"
                                               LineStackingStrategy="BlockLineHeight" />
                                    <TextBlock Text="{Binding DriverPointsDisplay}"
                                               FontSize="10" FontWeight="SemiBold"
                                               Foreground="#B8B8C4"
                                               HorizontalAlignment="Right"
                                               Margin="0,-2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
