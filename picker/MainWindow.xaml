<Window x:Class="F1SimHubLive.Picker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:F1SimHubLive.Picker.Services"
        xmlns:models="clr-namespace:F1SimHubLive.Picker.Models"
        Title="F1SimHubLive"
        Icon="Assets/picker.ico"
        Width="860" Height="960"
        MinWidth="760" MinHeight="540"
        Background="#0F0F12"
        Foreground="#E8E8EC"
        FontFamily="Segoe UI"
        Topmost="True"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <svc:HexToBrushConverter x:Key="HexToBrush" />
        <svc:LapStatusToBrushConverter x:Key="LapStatusToBrush" />
        <svc:LapStatusToBoxBackgroundConverter x:Key="LapStatusToBoxBg" />
        <svc:LapStatusToBoxForegroundConverter x:Key="LapStatusToBoxFg" />
        <svc:InPitTextToBackgroundConverter x:Key="InPitToBg" />
        <svc:InPitTextToForegroundConverter x:Key="InPitToFg" />
        <svc:SectorStatusToBrushConverter x:Key="SectorStatusToBrush" />
        <svc:SegmentStatusToBrushConverter x:Key="SegmentStatusToBrush" />
        <svc:PositionToTextConverter x:Key="PositionToText" />
        <svc:TruthyToVisibilityConverter x:Key="TruthyToVisibility" />
        <svc:CountToGridStarConverter x:Key="CountToGridStar" />
        <svc:ThrottleToArcGeometryConverter x:Key="ThrottleToArc" />

        <Style x:Key="DriverButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A1A20" />
            <Setter Property="BorderBrush" Value="#2A2A33" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#E8E8EC" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#23232C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E2E3A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="BorderBrush" Value="#3FD06A" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="Background" Value="#1B2A1F" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True" Margin="10">

        <!-- Race session header bar — country flag, race name + session
             type, lap counter (race only), session clock, and track-status
             pill. Two-line stack mirroring MV Live Timing: race name on
             the top line (medium, grey), clock + lap on the bottom line
             (big, bold, white). Placed FIRST in the DockPanel so it sits
             at the very top of the picker. DataContext is wired in
             code-behind to SessionInfoClient.Model. -->
        <Border x:Name="SessionHeaderBar"
                DockPanel.Dock="Top" Background="#15151B"
                CornerRadius="4" Padding="12,8" Margin="0,0,0,8"
                Visibility="{Binding HasSession, Converter={StaticResource TruthyToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Country flag — PNG from Assets/Flags/{iso2}.png so it
                     renders identically on every Windows version (no
                     dependence on Segoe UI Emoji's regional-indicator
                     glyph support). 4:3 aspect, sized to the row height. -->
                <Image Grid.Column="0"
                       Source="{Binding CountryFlagImage}"
                       Width="44" Height="33"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"
                       Stretch="Uniform" />

                <!-- Race-name / lap-clock stack. Both lines anchored left
                     so they read as a single block next to the flag, just
                     like MV does. -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <!-- Top line: race name + session type (e.g. "Canadian GP: Race"). -->
                    <TextBlock Text="{Binding RaceName}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="#B0B0BA"
                               Margin="0,0,0,1" />
                    <!-- Bottom line: clock + lap counter. BIG bold white
                         so the eye lands on the live numbers first, just
                         like MV. -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding TimeText}"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   FontFamily="Consolas"
                                   Margin="0,0,10,0" />
                        <TextBlock Text="{Binding LapText}"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="#FFFFFF" />
                    </StackPanel>
                </StackPanel>

                <!-- Spacer (Width="*") keeps the track-status pill flush right. -->

                <!-- Track status pill (green/yellow/red, etc.). -->
                <Border Grid.Column="3"
                        Background="{Binding TrackStatusBackground, Converter={StaticResource HexToBrush}}"
                        CornerRadius="3"
                        Padding="10,5"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding TrackStatusText}"
                               Foreground="{Binding TrackStatusForeground, Converter={StaticResource HexToBrush}}"
                               FontSize="14" FontWeight="Bold" />
                </Border>
            </Grid>
        </Border>

        <!-- Header -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <!-- Driver / app label block -->
                <ColumnDefinition Width="Auto" />
                <!-- Horizontal LED strip + live RPM readout, fills the middle.
                     Replaces the old left-side vertical LED column so the
                     driver list can extend the full width of the window. -->
                <ColumnDefinition Width="*" />
                <!-- Toggle buttons -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="F1SimHubLive" FontSize="13" FontWeight="Bold"
                           Foreground="#E83A3A" />
                <TextBlock x:Name="CurrentDriverText"
                           Text="—" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"
                           Foreground="#FFFFFF" />
            </StackPanel>

            <!-- Horizontal LED bar + live RPM readout.
                 LEDs render left-to-right (LED 1 .. LED 14, redline last on
                 the right) the way the wheel actually lights up. The numeric
                 RPM sits to the right of the bar so the eye can read it
                 without losing the visual cue. -->
            <Border Grid.Column="1"
                    Background="#0A0A0E"
                    CornerRadius="6" Padding="6,4"
                    BorderBrush="#1F1F26" BorderThickness="1"
                    Margin="16,4,16,0"
                    VerticalAlignment="Center">
                <DockPanel LastChildFill="True">
                    <TextBlock x:Name="RpmReadout"
                               DockPanel.Dock="Right"
                               Text="—"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="#9898A4"
                               VerticalAlignment="Center"
                               Margin="8,0,2,0"
                               MinWidth="44"
                               TextAlignment="Right"
                               FontFamily="Consolas"
                               ToolTip="Live RPM (MultiViewer telemetry)" />
                    <!-- Big gear letter sits just left of the RPM readout.
                         Broadcast convention: N=neutral, R=reverse,
                         1..8=current gear. v1.7.4. -->
                    <TextBlock x:Name="GearReadout"
                               DockPanel.Dock="Right"
                               Text="—"
                               FontSize="22" FontWeight="Bold"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"
                               Margin="6,0,4,0"
                               MinWidth="22"
                               TextAlignment="Center"
                               FontFamily="Consolas"
                               ToolTip="Live gear (MultiViewer CarData channel 3)" />
                    <!-- Thin vertical throttle bar on the left of the LED
                         strip, fills bottom-up green. v1.7.4. -->
                    <ProgressBar x:Name="ThrottleBar"
                                 DockPanel.Dock="Left"
                                 Orientation="Vertical"
                                 Minimum="0" Maximum="100" Value="0"
                                 Width="8" Height="22"
                                 Margin="2,0,8,0"
                                 Background="#1F1F26"
                                 Foreground="#00CC44"
                                 BorderBrush="#2A2A33"
                                 BorderThickness="1"
                                 ToolTip="Live throttle % (MultiViewer CarData channel 4)" />
                    <ItemsControl x:Name="LedStrip">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding}"
                                        Margin="1,0"
                                        CornerRadius="2"
                                        Height="22" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal"
                        VerticalAlignment="Center">
                <ToggleButton x:Name="LedToggle"
                              Content="💡 LEDs"
                              Foreground="#C8C8D0"
                              Background="Transparent"
                              BorderBrush="#2A2A33"
                              BorderThickness="1"
                              Padding="6,2"
                              Margin="0,0,8,0"
                              Cursor="Hand"
                              ToolTip="Show shift-light range sliders"
                              Checked="LedToggle_Changed"
                              Unchecked="LedToggle_Changed" />
                <CheckBox x:Name="AutoLaunchCheck"
                          Content="🚀 Auto-launch" IsChecked="False"
                          Foreground="#C8C8D0"
                          VerticalAlignment="Center"
                          Margin="0,0,10,0"
                          ToolTip="When checked, this picker launches automatically every time SimHub starts."
                          Checked="AutoLaunchCheck_Changed"
                          Unchecked="AutoLaunchCheck_Changed" />
                <CheckBox x:Name="TopmostCheck"
                          Content="📌 Pin" IsChecked="True"
                          Foreground="#C8C8D0"
                          VerticalAlignment="Center"
                          Checked="TopmostCheck_Changed"
                          Unchecked="TopmostCheck_Changed" />
            </StackPanel>
        </Grid>

        <!-- Status bar -->
        <Border DockPanel.Dock="Top" Background="#15151B"
                CornerRadius="4" Padding="8,5" Margin="0,0,0,8">
            <TextBlock x:Name="StatusText"
                       Text="Connecting to MultiViewer…"
                       FontSize="11" Foreground="#9090A0"
                       TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- Shift-light range sliders -->
        <Border x:Name="SliderStrip"
                DockPanel.Dock="Bottom" Background="#0A0A0E"
                CornerRadius="6" Padding="10,8" Margin="0,8,0,0"
                BorderBrush="#1F1F26" BorderThickness="1"
                Visibility="Collapsed">
            <StackPanel>
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Shift-light range" FontSize="10" FontWeight="SemiBold"
                               Foreground="#7F7F8A" />
                    <TextBlock Grid.Column="1" x:Name="RangeSummary"
                               Text=""
                               FontSize="10" Foreground="#9898A4" />
                </Grid>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Start" FontSize="11" Foreground="#C8C8D0"
                               VerticalAlignment="Center" />
                    <Slider Grid.Column="1" x:Name="StartRpmSlider"
                            Minimum="1000" Maximum="18000"
                            TickFrequency="500" IsSnapToTickEnabled="True"
                            SmallChange="100" LargeChange="500"
                            VerticalAlignment="Center"
                            Margin="6,0" />
                    <TextBlock Grid.Column="2" x:Name="StartRpmText"
                               Text="—"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="#E8E8EE"
                               VerticalAlignment="Center"
                               TextAlignment="Right" />
                </Grid>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="End" FontSize="11" Foreground="#C8C8D0"
                               VerticalAlignment="Center" />
                    <Slider Grid.Column="1" x:Name="EndRpmSlider"
                            Minimum="1000" Maximum="18000"
                            TickFrequency="500" IsSnapToTickEnabled="True"
                            SmallChange="100" LargeChange="500"
                            VerticalAlignment="Center"
                            Margin="6,0" />
                    <TextBlock Grid.Column="2" x:Name="EndRpmText"
                               Text="—"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="#E8E8EE"
                               VerticalAlignment="Center"
                               TextAlignment="Right" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="VersionText"
                       Grid.Column="0"
                       Text="v?.?.?"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="#C8C8D0"
                       VerticalAlignment="Center"
                       ToolTipService.ShowDuration="20000" />
            <TextBlock x:Name="UpdateText"
                       Grid.Column="1"
                       Visibility="Collapsed"
                       FontSize="14" FontWeight="SemiBold"
                       VerticalAlignment="Center">
                <Hyperlink x:Name="UpdateLink"
                           Foreground="#F5C04C"
                           TextDecorations="None"
                           RequestNavigate="UpdateLink_RequestNavigate"
                           NavigateUri="https://github.com/vicslive/F1SimHubLive/releases">
                    <Run x:Name="UpdateRun" Text="▲ update available" />
                </Hyperlink>
            </TextBlock>
        </Grid>

        <!-- Hidden — kept so existing code that writes to SettingsPathText
             (tooltip text) still compiles. The path now lives in
             VersionText.ToolTip. -->
        <TextBlock x:Name="SettingsPathText" Visibility="Collapsed" />

        <!-- Driver list — now spans full width. The LED preview moved to
             the header so the list can use every pixel for timing data. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="DriverList" Grid.IsSharedSizeScope="True">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:DriverTimingRow}">
                        <Button Style="{StaticResource DriverButtonStyle}"
                                Margin="0,0,0,3"
                                Click="DriverButton_Click"
                                Tag="{Binding RacingNumber}">
                            <Grid Height="56">
                                <Grid.ColumnDefinitions>
                                    <!-- Position number (tight, no padding so the TLA
                                         tile sits right next to it like MV) -->
                                    <ColumnDefinition Width="26" />
                                    <!-- Team-colour TLA tile -->
                                    <ColumnDefinition Width="52" />
                                    <!-- v1.7.4: per-driver input cluster (gear circle +
                                         RPM number underneath), matches F1 Live Timing
                                         pattern. -->
                                    <ColumnDefinition Width="50" />
                                    <!-- Current speed (km/h) -->
                                    <ColumnDefinition Width="72" />
                                    <!-- LAST + BEST lap times — widened from 92 to 120
                                         after dropping the name+team column so the PB/SB
                                         pills have room to render without clipping. -->
                                    <ColumnDefinition Width="120" />
                                    <!-- INT + LDR — widened from 78 to 100 so the
                                         "IN PIT" red pill doesn't get truncated. -->
                                    <ColumnDefinition Width="100" />
                                    <!-- Tire badge + age -->
                                    <ColumnDefinition Width="50" />
                                    <!-- Pit count -->
                                    <ColumnDefinition Width="30" />
                                    <!-- Sector segment strip (3 sectors, two-row times).
                                         Star with MinWidth so it absorbs all remaining
                                         horizontal space. -->
                                    <ColumnDefinition Width="*" MinWidth="260" />
                                </Grid.ColumnDefinitions>

                                <!-- Position tile — dark grey rounded block, matches
                                     MV Live Timing's two-tone driver block. Paired with
                                     the team-coloured TLA tile to the right with a small
                                     seam gap so both halves read as a single unit. -->
                                <Border Grid.Column="0"
                                        Background="#26262E"
                                        CornerRadius="3"
                                        Margin="2,3,1,3">
                                    <TextBlock Text="{Binding Position, Converter={StaticResource PositionToText}}"
                                               FontSize="16" FontWeight="Black"
                                               Foreground="#E8E8EE"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <!-- TLA tile — team colour, rounded, with a 1px seam gap
                                     to the position tile to match MV's two-tone block. -->
                                <Border Grid.Column="1"
                                        Background="{Binding TeamColour, Converter={StaticResource HexToBrush}}"
                                        CornerRadius="3"
                                        Margin="1,3,0,3">
                                    <TextBlock Text="{Binding Tla}"
                                               Foreground="White"
                                               FontSize="16" FontWeight="Black"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <!-- v1.7.4: per-driver input cluster. Circular ring with
                                     the gear letter centered, RPM number in red beneath.
                                     Matches the F1 Live Timing per-row layout shown in
                                     the broadcast feed. Bound to MV CarData channels 3
                                     (gear) and 0 (rpm) via PickerTelemetryClient.OnInputsBatch. -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                            HorizontalAlignment="Center" Margin="0,0,4,0">
                                    <Grid Width="34" Height="34">
                                        <Ellipse Stroke="#3A3A44" StrokeThickness="2"
                                                 Fill="#0F0F14" />
                                        <!-- v1.7.5: blue throttle arc — sweeps clockwise
                                             from ~8 o'clock around the ring as throttle
                                             goes 0->100. Matches the F1 Live Timing
                                             per-row gear-ring throttle indicator. -->
                                        <Path Stroke="#3399FF" StrokeThickness="3"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Data="{Binding Throttle, Converter={StaticResource ThrottleToArc}}"
                                              IsHitTestVisible="False" />
                                        <TextBlock Text="{Binding GearText}"
                                                   FontSize="18" FontWeight="Black"
                                                   Foreground="#E8E8EE"
                                                   FontFamily="Consolas"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   ToolTip="Current gear (MV CarData ch.3)" />
                                    </Grid>
                                    <TextBlock Text="{Binding RpmText}"
                                               FontSize="12" FontWeight="Bold"
                                               Foreground="#E8E8EE"
                                               FontFamily="Consolas"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Margin="0,1,0,0"
                                               ToolTip="Current RPM (MV CarData ch.0)" />
                                </StackPanel>

                                <!-- Current speed (km/h) — big number with a tiny unit label.
                                     Updated from MV CarData channel "2" via the
                                     telemetry client's OnSpeedsBatch event. -->
                                <StackPanel Grid.Column="3" VerticalAlignment="Center"
                                            HorizontalAlignment="Right"
                                            Margin="0,0,6,0">
                                    <TextBlock Text="{Binding SpeedKmh}"
                                               FontSize="20" FontWeight="Black"
                                               Foreground="#E8E8EE"
                                               TextAlignment="Right"
                                               FontFamily="Consolas"
                                               LineHeight="22"
                                               LineStackingStrategy="BlockLineHeight" />
                                    <TextBlock Text="km/h"
                                               FontSize="8" FontWeight="SemiBold"
                                               Foreground="#6F6F7A"
                                               TextAlignment="Right"
                                               Margin="0,0,0,0" />
                                </StackPanel>

                                <!-- LAST + BEST lap times stack -->
                                <StackPanel Grid.Column="4" VerticalAlignment="Center"
                                            Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="LAST"
                                                   FontSize="8" FontWeight="SemiBold"
                                                   Foreground="#6F6F7A"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,5,0" />
                                        <Border Background="{Binding LastLapStatus, Converter={StaticResource LapStatusToBoxBg}}"
                                                CornerRadius="8" Padding="6,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding LastLapTime}"
                                                       FontSize="14" FontWeight="Bold"
                                                       Foreground="{Binding LastLapStatus, Converter={StaticResource LapStatusToBoxFg}}"
                                                       TextAlignment="Right"
                                                       FontFamily="Consolas" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                Margin="0,1,0,0">
                                        <TextBlock Text="BEST"
                                                   FontSize="8" FontWeight="SemiBold"
                                                   Foreground="#6F6F7A"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,5,0" />
                                        <Border Background="{Binding BestLapStatus, Converter={StaticResource LapStatusToBoxBg}}"
                                                CornerRadius="8" Padding="6,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding BestLapTime}"
                                                       FontSize="14" FontWeight="Bold"
                                                       Foreground="{Binding BestLapStatus, Converter={StaticResource LapStatusToBoxFg}}"
                                                       TextAlignment="Right"
                                                       FontFamily="Consolas" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- INT + LDR stack (matches MultiViewer terminology:
                                     INT = interval to car ahead, LDR = gap to leader) -->
                                <StackPanel Grid.Column="5" VerticalAlignment="Center"
                                            Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="INT"
                                                   FontSize="8" FontWeight="SemiBold"
                                                   Foreground="#6F6F7A"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,5,0" />
                                        <Border Background="{Binding IntervalToAhead, Converter={StaticResource InPitToBg}}"
                                                CornerRadius="8" Padding="6,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding IntervalToAhead}"
                                                       FontSize="14" FontWeight="Bold"
                                                       Foreground="{Binding IntervalToAhead, Converter={StaticResource InPitToFg}}"
                                                       TextAlignment="Right"
                                                       FontFamily="Consolas" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                Margin="0,1,0,0">
                                        <TextBlock Text="LDR"
                                                   FontSize="8" FontWeight="SemiBold"
                                                   Foreground="#6F6F7A"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,5,0" />
                                        <Border Background="{Binding GapToLeader, Converter={StaticResource InPitToBg}}"
                                                CornerRadius="8" Padding="6,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding GapToLeader}"
                                                       FontSize="14" FontWeight="Bold"
                                                       Foreground="{Binding GapToLeader, Converter={StaticResource InPitToFg}}"
                                                       TextAlignment="Right"
                                                       FontFamily="Consolas" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Tire badge + age. Vic explicitly wanted this kept
                                     at the current visual size — the whole row height
                                     is now tuned around the tire stack's natural
                                     footprint (28px badge + 1 + ~10 text = ~40px). -->
                                <StackPanel Grid.Column="6"
                                            Orientation="Vertical"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Border Background="{Binding TireCompoundColor, Converter={StaticResource HexToBrush}}"
                                            Width="34" Height="34"
                                            CornerRadius="17"
                                            BorderBrush="#0A0A0E"
                                            BorderThickness="2">
                                        <TextBlock Text="{Binding TireCompoundLetter}"
                                                   Foreground="#0A0A0E"
                                                   FontSize="15" FontWeight="Black"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding TireAge}"
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="#E8E8EE"
                                               HorizontalAlignment="Center"
                                               Margin="0,1,0,0" />
                                </StackPanel>

                                <!-- Pit count -->
                                <StackPanel Grid.Column="7"
                                            Orientation="Vertical"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding PitStopCount, Converter={StaticResource TruthyToVisibility}}">
                                    <TextBlock Text="PIT"
                                               FontSize="8" FontWeight="SemiBold"
                                               Foreground="#6F6F7A"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding PitStopCount}"
                                               FontSize="16" FontWeight="Black"
                                               Foreground="#E8E8EE"
                                               HorizontalAlignment="Center"
                                               LineHeight="18"
                                               LineStackingStrategy="BlockLineHeight" />
                                </StackPanel>

                                <!-- Sector segment strip — three sectors, each with
                                     mini-bars on top, current sector time in the
                                     middle, and best sector time at the bottom
                                     (yellow=PB, purple=session best), matching
                                     MultiViewer's two-row time stack.
                                     Sub-column widths are weighted by each sector's
                                     SegmentCount so the per-segment bar pixel width
                                     stays uniform across S1/S2/S3 — without this the
                                     sector with the most mini-sectors visually has
                                     skinnier bars than the others. -->
                                <Grid Grid.Column="8" Margin="4,2,2,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding Sectors[0].SegmentCount, Converter={StaticResource CountToGridStar}}" />
                                        <ColumnDefinition Width="{Binding Sectors[1].SegmentCount, Converter={StaticResource CountToGridStar}}" />
                                        <ColumnDefinition Width="{Binding Sectors[2].SegmentCount, Converter={StaticResource CountToGridStar}}" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- S1 segments -->
                                    <ItemsControl Grid.Column="0" Grid.Row="0"
                                                  ItemsSource="{Binding Sectors[0].Segments}"
                                                  Margin="0,0,2,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Converter={StaticResource SegmentStatusToBrush}}"
                                                        Margin="0,0,1,0"
                                                        CornerRadius="1" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Grid.Column="0" Grid.Row="1"
                                               Text="{Binding Sectors[0].Time}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{Binding Sectors[0].Status, Converter={StaticResource SectorStatusToBrush}}"
                                               FontFamily="Consolas"
                                               TextAlignment="Center"
                                               Margin="0,1,2,0" />
                                    <TextBlock Grid.Column="0" Grid.Row="2"
                                               Text="{Binding Sectors[0].BestTime}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{Binding Sectors[0].BestStatus, Converter={StaticResource SectorStatusToBrush}}"
                                               FontFamily="Consolas"
                                               TextAlignment="Center"
                                               Margin="0,0,2,0" />

                                    <!-- S2 segments -->
                                    <ItemsControl Grid.Column="1" Grid.Row="0"
                                                  ItemsSource="{Binding Sectors[1].Segments}"
                                                  Margin="0,0,2,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Converter={StaticResource SegmentStatusToBrush}}"
                                                        Margin="0,0,1,0"
                                                        CornerRadius="1" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Grid.Column="1" Grid.Row="1"
                                               Text="{Binding Sectors[1].Time}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{Binding Sectors[1].Status, Converter={StaticResource SectorStatusToBrush}}"
                                               FontFamily="Consolas"
                                               TextAlignment="Center"
                                               Margin="0,1,2,0" />
                                    <TextBlock Grid.Column="1" Grid.Row="2"
                                               Text="{Binding Sectors[1].BestTime}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{Binding Sectors[1].BestStatus, Converter={StaticResource SectorStatusToBrush}}"
                                               FontFamily="Consolas"
                                               TextAlignment="Center"
                                               Margin="0,0,2,0" />

                                    <!-- S3 segments -->
                                    <ItemsControl Grid.Column="2" Grid.Row="0"
                                                  ItemsSource="{Binding Sectors[2].Segments}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Converter={StaticResource SegmentStatusToBrush}}"
                                                        Margin="0,0,1,0"
                                                        CornerRadius="1" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Grid.Column="2" Grid.Row="1"
                                               Text="{Binding Sectors[2].Time}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{Binding Sectors[2].Status, Converter={StaticResource SectorStatusToBrush}}"
                                               FontFamily="Consolas"
                                               TextAlignment="Center"
                                               Margin="0,1,0,0" />
                                    <TextBlock Grid.Column="2" Grid.Row="2"
                                               Text="{Binding Sectors[2].BestTime}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{Binding Sectors[2].BestStatus, Converter={StaticResource SectorStatusToBrush}}"
                                               FontFamily="Consolas"
                                               TextAlignment="Center"
                                               Margin="0,0,0,0" />
                                </Grid>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
